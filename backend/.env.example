# Copy this file to .env and fill in real values. Never commit .env.

# Port the API listens on (localhost only; nginx proxies /api to it)
PORT=4100

# MongoDB connection. Use a dedicated user that can only access the paygoal database.
# Example: mongodb://paygoal_app:STRONG_PASSWORD@127.0.0.1:27017/paygoal?authSource=paygoal
MONGODB_URI=mongodb://127.0.0.1:27017

# Database name. Must start with "paygoal" (safety check so the app never touches another project's database).
MONGODB_DB=paygoal

# Long random secret for login sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters

# true in production (HTTPS). Use false for local development over http.
COOKIE_SECURE=false
